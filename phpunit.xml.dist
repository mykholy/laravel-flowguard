<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true">
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
        <testsuite name="Concurrency">
            <file>tests/Concurrency/DatabaseRaceTest.php</file>
            <file>tests/Concurrency/EvidenceJournalDatabaseTest.php</file>
            <file>tests/Concurrency/ManualResolutionRaceTest.php</file>
            <file>tests/Concurrency/OutboxDatabaseTest.php</file>
            <file>tests/Concurrency/InboxDatabaseTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
    </php>
</phpunit>
